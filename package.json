{
    "name": "eslint-plugin-yet-another-license-header",
    "version": "0.2.0",
    "description": "Yet another ESLint plugin to handle a license top-comment in your JS/TS files",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "type": "commonjs",
    "main": "index.js",
    "directories": {
        "lib": "lib"
    },
    "files": [
        "README.md",
        "LICENSE",
        "CHANGELOG.md",
        "package.json",
        "index.js",
        "lib"
    ],
    "engines": {
        "node": "^18.18.0 || >=20.9.0"
    },
    "scripts": {
        "prepush": "npm run lint && npm run test",
        "lint": "eslint && prettier --check .",
        "lint:fix": "eslint --fix && prettier --write .",
        "test": "mocha 'test/**.test.js'",
        "tav": "tav",
        "zizmor": "zizmor --gh-token $(gh auth token) .",
        "zizmor:fix": "zizmor --gh-token $(gh auth token) --fix=all ."
    },
    "keywords": [
        "eslint",
        "plugin",
        "header",
        "license"
    ],
    "author": "Trent Mick <trentm@gmail.com>",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git://github.com/trentm/eslint-plugin-yet-another-license-header.git"
    },
    "homepage": "https://github.com/trentm/eslint-plugin-yet-another-license-header#readme",
    "devDependencies": {
        "@eslint/compat": "^2.1.0",
        "@eslint/js": "^10.0.1",
        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-eslint-plugin": "^7.0.0",
        "globals": "^16.4.0",
        "mocha": "^11.7.2",
        "prettier": "^3.6.2",
        "test-all-versions": "^6.2.0"
    }
}
