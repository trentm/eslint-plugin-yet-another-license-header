{
    "name": "eslint-plugin-yet-another-license-header",
    "version": "0.1.0",
    "description": "Yet another ESLint plugin to handle a license top-comment in your JS/TS files",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "type": "commonjs",
    "main": "index.js",
    "directories": {
        "lib": "lib"
    },
    "files": [
        "README.md",
        "LICENSE",
        "CHANGELOG.md",
        "package.json",
        "index.js",
        "lib"
    ],
    "engines": {
        "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
    },
    "scripts": {
        "lint": "eslint && prettier --check .",
        "lint:fix": "eslint --fix && prettier --write .",
        "test": "mocha 'test/**.test.js'"
    },
    "keywords": [
        "eslint",
        "plugin",
        "header",
        "license"
    ],
    "author": "Trent Mick <trentm@gmail.com>",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git://github.com/trentm/eslint-plugin-yet-another-license-header.git"
    },
    "homepage": "https://github.com/trentm/eslint-plugin-yet-another-license-header#readme",
    "devDependencies": {
        "@eslint/compat": "^1.3.2",
        "@eslint/js": "^9.35.0",
        "eslint": "^9.35.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-eslint-plugin": "^7.0.0",
        "globals": "^16.4.0",
        "mocha": "^11.7.2",
        "prettier": "^3.6.2"
    }
}
